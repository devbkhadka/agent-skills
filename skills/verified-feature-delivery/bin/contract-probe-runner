#!/usr/bin/env python3
"""Stage 1 Probe Runner & Contract Fixture Generator: contract-probe-runner.

Owner: stage-1
Purpose: Executes live boundary probing and generates immutable interface contract
fixtures stamped with fixture_status (PROBED_LIVE, REPLAYED_FROM_RECORDING, PROVISIONAL_FROM_SCHEMA).
"""

import argparse
import datetime
import json
import os
from pathlib import Path
import subprocess
import sys


VALID_FIXTURE_STATUSES = [
    "PROBED_LIVE",
    "REPLAYED_FROM_RECORDING",
    "PROVISIONAL_FROM_SCHEMA",
]

CANONICAL_BOUNDARY_CLASSES = [
    "SUBPROCESS_CLI",
    "NETWORK_API",
    "FRAMEWORK_MIDDLEWARE",
    "DATASTORE",
    "MESSAGE_TRANSPORT",
    "DEVICE_IO",
    "MODEL_ENDPOINT",
    "UI_RUNTIME",
    "VERIFICATION_HARNESS",
    "OTHER",
]


def create_fixture_template(
    boundary_class: str,
    boundary_identifier: str,
    property_name: str,
    fixture_status: str = "PROBED_LIVE",
    pinned_reprobe_milestone: str = None,
    contract_reference: str = None,
) -> dict:
    """Generate a valid contract fixture dictionary adhering to contract-fixture.schema.json."""
    if boundary_class not in CANONICAL_BOUNDARY_CLASSES:
        raise ValueError(f"Invalid boundary_class: {boundary_class}")
    if fixture_status not in VALID_FIXTURE_STATUSES:
        raise ValueError(f"Invalid fixture_status: {fixture_status}")

    return {
        "schema_version": "1.0.0",
        "boundary_class": boundary_class,
        "boundary_identifier": boundary_identifier,
        "property_name": property_name,
        "fixture_status": fixture_status,
        "pinned_reprobe_milestone": pinned_reprobe_milestone,
        "contract_reference": contract_reference,
        "contract_variant_selectors": [],
        "success_samples": [
            {
                "sample_id": "sample_primary_success",
                "partition_cell": {},
                "status_code": 200 if boundary_class == "NETWORK_API" else None,
                "exit_code": 0 if boundary_class == "SUBPROCESS_CLI" else None,
                "headers": {"content-type": "application/json"} if boundary_class == "NETWORK_API" else {},
                "payload": {"status": "ok", "result": "sample_output"},
            }
        ],
        "failure_envelope_census": [
            {
                "envelope_id": "standard_error_envelope",
                "error_class": "CLIENT_ERROR",
                "status_code": 400 if boundary_class == "NETWORK_API" else None,
                "exit_code": 1 if boundary_class == "SUBPROCESS_CLI" else None,
                "payload_type": "JSON",
                "payload": {"error": "bad_request", "detail": "Invalid parameters"},
                "description": "Standard client request error envelope.",
            }
        ],
        "variance_census": {
            "unbounded_regions": [],
            "contract_variant_selectors": [],
            "partition_cells_evaluated": [],
            "variance_analysis": {
                "key_intersection": [],
                "key_union": [],
            },
        },
    }


def execute_probe_script(probe_path: Path, timeout: int = 30) -> tuple:
    """Execute probe script if present and executable."""
    if not probe_path.is_file():
        return False, f"Probe script not found: {probe_path}"

    try:
        if probe_path.suffix == ".py":
            cmd = [sys.executable, str(probe_path)]
        elif probe_path.suffix in [".sh", ".bash"]:
            cmd = ["bash", str(probe_path)]
        else:
            cmd = [str(probe_path)]

        proc = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return True, {
            "exit_code": proc.returncode,
            "stdout": proc.stdout,
            "stderr": proc.stderr,
        }
    except Exception as e:
        return False, f"Probe execution failed: {e}"


def build_parser():
    parser = argparse.ArgumentParser(
        description="Agentic Feature Planner - Stage 1 Contract Probe Runner",
        prog="contract-probe-runner",
    )
    subparsers = parser.add_subparsers(dest="command", help="Subcommand")

    # init-fixture
    p_init = subparsers.add_parser("init-fixture", help="Generate a contract fixture template")
    p_init.add_argument("--class", dest="boundary_class", required=True, choices=CANONICAL_BOUNDARY_CLASSES)
    p_init.add_argument("--id", dest="boundary_id", required=True, help="Boundary identifier")
    p_init.add_argument("--property", required=True, help="Property name")
    p_init.add_argument("--status", default="PROBED_LIVE", choices=VALID_FIXTURE_STATUSES)
    p_init.add_argument("--reprobe-milestone", help="Pinned re-probe milestone if PROVISIONAL_FROM_SCHEMA")
    p_init.add_argument("--contract-ref", help="Reference to contract interface")
    p_init.add_argument("--out", "-o", help="Output file path")

    # run-probe
    p_run = subparsers.add_parser("run-probe", help="Run a probe script and record results")
    p_run.add_argument("probe_path", help="Path to probe executable")
    p_run.add_argument("--out", "-o", help="Output fixture path")

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    if not args.command:
        # Default behavior: report status
        print("CONTRACT_PROBE_RUNNER_AVAILABLE")
        return 0

    if args.command == "init-fixture":
        fixture = create_fixture_template(
            boundary_class=args.boundary_class,
            boundary_identifier=args.boundary_id,
            property_name=args.property,
            fixture_status=args.status,
            pinned_reprobe_milestone=args.reprobe_milestone,
            contract_reference=args.contract_ref,
        )
        out_json = json.dumps(fixture, indent=2) + "\n"
        if args.out:
            out_p = Path(args.out)
            out_p.parent.mkdir(parents=True, exist_ok=True)
            out_p.write_text(out_json, encoding="utf-8")
            print(f"FIXTURE_WRITTEN: {out_p}")
        else:
            sys.stdout.write(out_json)
        return 0

    if args.command == "run-probe":
        probe_p = Path(args.probe_path)
        ok, res = execute_probe_script(probe_p)
        if not ok:
            sys.stderr.write(f"PROBE_EXECUTION_ERROR: {res}\n")
            return 1
        print(f"PROBE_EXECUTED_SUCCESSFULLY: exit {res['exit_code']}")
        return 0

    return 0


if __name__ == "__main__":
    sys.exit(main())
