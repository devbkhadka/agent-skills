#!/usr/bin/env python3
"""Stage 4/5 live browser UI observation runner: observe-rendered-ui.

Owner: stage-5.

Drives headless Chromium via Playwright out-of-process to observe and capture the rendered DOM
from an agent-declared observation target. Refuses missing browsers, unreachable targets,
empty renderings, and unexecutable client scripts.

Exit codes:
- 0: Observation succeeded clean (prints OBSERVATION_CAPTURED_CLEAN and DOM markup)
- Non-zero: Prints bare error code token (OBSERVATION_BROWSER_UNAVAILABLE,
  OBSERVATION_TARGET_UNREACHABLE, OBSERVATION_RENDER_EMPTY).
"""

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib.normalisation import normalise_rendered_ui
from lib.observation import (
    OBSERVATION_TARGET_KEYS,
    observe_rendered_ui,
)
from lib.primitives import check_closed_key_set


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Live Browser UI Observation Runner",
        prog="observe-rendered-ui",
    )
    parser.add_argument("--target", help="Path to JSON file containing observation_target configuration")
    parser.add_argument("--entry-point", help="Path to static HTML entry point file")
    parser.add_argument("--url", help="HTTP/HTTPS URL of running server")
    parser.add_argument("--server-cmd", help="Command to spawn local server")
    parser.add_argument("--port", type=int, default=4173, help="Port to wait for when spawning server")
    parser.add_argument("--wait-for-selector", help="CSS selector to wait for before capturing DOM")
    parser.add_argument("--timeout-ms", type=int, default=10000, help="Timeout in milliseconds")
    parser.add_argument("--out", "-o", help="Output file path to write observed capture JSON")
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    target_config = {}
    base_dir = Path.cwd()

    if args.target:
        target_path = Path(args.target)
        if not target_path.is_file():
            print("OBSERVATION_TARGET_UNREACHABLE: target file not found: %s" % target_path)
            return 1
        try:
            target_data = json.loads(target_path.read_text(encoding="utf-8"))
        except Exception as e:
            print("OBSERVATION_TARGET_UNREACHABLE: invalid target JSON: %s" % e)
            return 1

        if isinstance(target_data, dict) and "observation_target" in target_data:
            target_config = target_data["observation_target"]
        elif isinstance(target_data, dict):
            target_config = target_data
        base_dir = target_path.parent
    else:
        if args.entry_point:
            target_config["entry_point"] = args.entry_point
        if args.url:
            target_config["url"] = args.url
        if args.server_cmd:
            target_config["server_command"] = args.server_cmd
        if args.port:
            target_config["port"] = args.port
        if args.wait_for_selector:
            target_config["wait_for_selector"] = args.wait_for_selector
        if args.timeout_ms:
            target_config["timeout_ms"] = args.timeout_ms

    if not target_config:
        print("OBSERVATION_TARGET_UNDECLARED: no observation target specified (--target, --entry-point, --url, or --server-cmd)")
        return 1

    closed = check_closed_key_set(target_config, OBSERVATION_TARGET_KEYS, label="observation target")
    if not closed.is_valid:
        print("UNKNOWN_DELIVERY_ATTRIBUTE: %s" % closed.message)
        return 1

    observed_markup, err_code, err_detail = observe_rendered_ui(target_config, base_dir=base_dir)
    if err_code:
        print("%s: %s" % (err_code, err_detail))
        return 1

    try:
        normalised = normalise_rendered_ui(observed_markup)
    except Exception as e:
        print("OBSERVATION_RENDER_EMPTY: failed to normalise observed DOM: %s" % e)
        return 1

    if normalised == "[empty_dom]":
        print("OBSERVATION_RENDER_EMPTY: observed DOM contains no observable content")
        return 1

    if args.out:
        out_p = Path(args.out)
        out_p.parent.mkdir(parents=True, exist_ok=True)
        capture_data = {
            "captured_artifact": observed_markup,
            "recorded_fixture_values": [],
            "observation_target": target_config,
        }
        out_p.write_text(json.dumps(capture_data, indent=2) + "\n", encoding="utf-8")

    print("OBSERVATION_CAPTURED_CLEAN: observed %d characters of rendered DOM markup" % len(observed_markup))
    return 0


if __name__ == "__main__":
    sys.exit(main())
