#!/usr/bin/env python3
"""State manager and transition engine for verified-feature-delivery.

Enforces the architecture specification Section 4 state transition table as a
declarative data structure. Tracks lifecycle progress, gate exit artifacts,
and regression rollback routing in .verified-feature-delivery/<feature-slug>/state.json.
"""

from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import sys

# Milestones gated by a human approval record (improvement plan §5.1). Each
# awaiting-approval state below can only be left once bin/record-approval has
# written a matching, digest-valid record for the milestone_id it guards --
# bin/planner-state advance never approves anything itself.
MILESTONES = {
    "FLOW_SIMULATION": {
        "awaiting_state": "AWAITING_FLOW_SIMULATION_APPROVAL",
        "artifact_path": "flow-simulation-matrix.json",
        "digest_scope": ["flows", "flow_groups", "states", "transitions"],
        "derived_docs": ["ubiquitous-language-glossary.md", "flow-simulation.md"],
    },
    "ENTITY_BOUNDARIES": {
        "awaiting_state": "AWAITING_ENTITY_BOUNDARIES_APPROVAL",
        # The guarded entity boundaries, relationships and simulated dependencies are Stage 0
        # declarations in the lexicon; the scenario matrix carries none of them.
        "artifact_path": "domain-lexicon.json",
        "digest_scope": ["entity_boundaries", "entity_relationships", "simulated_dependencies"],
        "derived_docs": ["domain-entity-map.md"],
    },
    "UI_LAYOUT": {
        "awaiting_state": "AWAITING_UI_LAYOUT_APPROVAL",
        "artifact_path": "execution-dag.json",
        "digest_scope": ["ui_layout"],
        "derived_docs": [],
    },
}
AWAITING_STATE_TO_MILESTONE = {meta["awaiting_state"]: mid for mid, meta in MILESTONES.items()}

# Linear pipeline order used only to tell "already passed this gate" (stale
# check) apart from "sitting at this gate right now" (leaving-gate check).
# Stage 4 regression targets are reached via cmd_rollback, a separate path
# that does not consult this ordering.
STATE_ORDER = [
    "UNINITIALIZED",
    "STAGE_0_DOMAIN_INGESTION",
    "STAGE_1_CONTRACT_PROBING",
    "STAGE_2_SCENARIO_SIMULATION",
    "AWAITING_FLOW_SIMULATION_APPROVAL",
    "AWAITING_ENTITY_BOUNDARIES_APPROVAL",
    "STAGE_3_VERTICAL_SLICING",
    "AWAITING_UI_LAYOUT_APPROVAL",
    "STAGE_4_MILESTONE_EXECUTION",
    "STAGE_5_DELIVERY",
    "COMPLETED",
]


def state_ordinal(state_name):
    return STATE_ORDER.index(state_name) if state_name in STATE_ORDER else -1


def canonical_digest(artifact, scope_keys):
    """sha256 over the sorted-key, whitespace-free JSON of the named subtrees."""
    scoped = {k: artifact[k] for k in scope_keys if k in artifact}
    blob = json.dumps(scoped, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def load_artifact(feature_dir, rel_path):
    p = feature_dir / rel_path
    if not p.is_file():
        return None
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return None


def load_ledger(feature_dir):
    p = feature_dir / "approvals.json"
    if not p.is_file():
        return None
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return None
    if not isinstance(data, dict) or not isinstance(data.get("approvals"), list):
        return None
    return data


def save_ledger(feature_dir, ledger_data):
    p = feature_dir / "approvals.json"
    p.write_text(json.dumps(ledger_data, indent=2) + "\n", encoding="utf-8")


def find_approval(ledger_data, milestone_id):
    if not ledger_data:
        return None
    for r in ledger_data.get("approvals", []):
        if isinstance(r, dict) and r.get("milestone_id") == milestone_id:
            return r
    return None


def mark_approval_stale(feature_dir, ledger_data, milestone_id, stale_elements=None):
    for r in ledger_data.get("approvals", []):
        if r.get("milestone_id") == milestone_id:
            r["status"] = "STALE"
            if stale_elements is not None:
                r["stale_elements"] = stale_elements
    save_ledger(feature_dir, ledger_data)


def _skill_lib():
    """Put the skill root on sys.path so the shared lib/ package imports."""
    skill_root = str(Path(__file__).resolve().parent.parent)
    if skill_root not in sys.path:
        sys.path.insert(0, skill_root)


def stale_element_ids(feature_dir, milestone_id):
    """The element ids a stale approval no longer matches, or None for a legacy record.

    A record written before element-scoped approvals carries no element_digests; it stays
    whole-section, exactly as before.
    """
    rec = find_approval(load_ledger(feature_dir), milestone_id)
    if not rec or not isinstance(rec.get("element_digests"), dict):
        return None
    meta = MILESTONES[milestone_id]
    artifact = load_artifact(feature_dir, meta["artifact_path"])
    _skill_lib()
    from lib.baseline import changed_element_ids, scoped_element_digests
    current = scoped_element_digests(artifact, meta["digest_scope"])
    return changed_element_ids(rec["element_digests"], current)


def _remove_derived_file(p):
    """Delete one derived document; report, never raise, when it cannot be removed.

    Called only after the state transition and the ledger are saved, so a document that cannot
    be removed (a directory left at its path, a permission the process lacks) leaves the feature
    recoverable at its awaiting gate rather than half-invalidated. Returns False on failure.
    """
    if not p.exists() and not p.is_symlink():
        return True
    if p.is_dir() and not p.is_symlink():
        sys.stderr.write(
            "DERIVED_DOCUMENT_NOT_DELETED: %s is a directory, not a rendered document; remove it "
            "by hand before re-rendering\n" % p
        )
        return False
    try:
        try:
            p.unlink()
        except PermissionError:
            p.chmod(0o644)
            p.unlink()
    except OSError as error:
        sys.stderr.write("DERIVED_DOCUMENT_NOT_DELETED: %s (%s)\n" % (p, error))
        return False
    return True


def delete_derived_docs(feature_dir, doc_names):
    docs_dir = feature_dir / "docs"
    for name in doc_names:
        _remove_derived_file(docs_dir / name)


def find_stale_milestone(feature_dir, state_data):
    """Return the milestone_id of the earliest-gated record that is already STALE, or
    APPROVED with a recomputed digest that no longer matches its artifact, considering only
    milestones the pipeline has already advanced past. A mismatch on the
    milestone the pipeline is currently sitting at is not staleness -- it is
    handled by the leaving-the-gate check in cmd_advance instead.

    UI_LAYOUT is excluded here: its approval is scoped per slice rather than
    to the whole artifact, so it is handled separately by
    find_stale_ui_layout_slices, which walks every ui_layout-bearing slice
    instead of the single top-level digest_scope this function checks.
    """
    current_ord = state_ordinal(state_data.get("current_state"))
    ledger_data = load_ledger(feature_dir)
    if not ledger_data:
        return None
    candidates = []
    for milestone_id, meta in MILESTONES.items():
        if milestone_id == "UI_LAYOUT":
            continue
        awaiting_ord = state_ordinal(meta["awaiting_state"])
        if awaiting_ord < 0 or awaiting_ord >= current_ord:
            continue
        rec = find_approval(ledger_data, milestone_id)
        if not rec:
            continue
        # A STALE record past its own gate is an invalidation that was interrupted before the
        # state transition landed; it still requires the awaiting state, so re-advance recovers.
        if rec.get("status") == "STALE":
            candidates.append((awaiting_ord, milestone_id))
            continue
        if rec.get("status") != "APPROVED":
            continue
        artifact = load_artifact(feature_dir, meta["artifact_path"])
        if artifact is None:
            continue
        if canonical_digest(artifact, meta["digest_scope"]) != rec.get("approved_digest"):
            candidates.append((awaiting_ord, milestone_id))
    if not candidates:
        return None
    candidates.sort()
    return candidates[0][1]


def ui_slices_with_layout(artifact):
    """slice_ids in the execution DAG that declare a non-empty ui_layout."""
    result = []
    for sl in (artifact or {}).get("slices", []) or []:
        if isinstance(sl, dict) and isinstance(sl.get("ui_layout"), dict) and sl.get("ui_layout"):
            result.append(sl.get("slice_id"))
    return result


def slice_ui_layout_digest(artifact, slice_id):
    """sha256 over the sorted-key, whitespace-free JSON of one slice's own ui_layout -- the
    per-slice counterpart to canonical_digest, which scopes to the whole artifact."""
    for sl in (artifact or {}).get("slices", []) or []:
        if isinstance(sl, dict) and sl.get("slice_id") == slice_id:
            blob = json.dumps(
                {"ui_layout": sl.get("ui_layout")},
                sort_keys=True,
                separators=(",", ":"),
                ensure_ascii=True,
            )
            return hashlib.sha256(blob.encode("utf-8")).hexdigest()
    return None


def find_ui_layout_approval(ledger_data, slice_id):
    if not ledger_data:
        return None
    for r in ledger_data.get("approvals", []):
        if isinstance(r, dict) and r.get("milestone_id") == "UI_LAYOUT" and r.get("slice_id") == slice_id:
            return r
    return None


def mark_ui_layout_stale(ledger_data, slice_id):
    for r in ledger_data.get("approvals", []):
        if r.get("milestone_id") == "UI_LAYOUT" and r.get("slice_id") == slice_id:
            r["status"] = "STALE"


def delete_ui_mockup(feature_dir, slice_id):
    _remove_derived_file(feature_dir / "docs" / ("ui-mockup-%s.html" % slice_id))


def find_stale_ui_layout_slices(feature_dir, state_data):
    """Return the slice_ids whose UI_LAYOUT record is already STALE, or APPROVED but no longer
    matching that slice's current ui_layout content. Only meaningful once the pipeline has already left
    AWAITING_UI_LAYOUT_APPROVAL -- a mismatch while still sitting at that gate is handled by the
    leaving-the-gate check in cmd_advance instead."""
    current_ord = state_ordinal(state_data.get("current_state"))
    awaiting_ord = state_ordinal("AWAITING_UI_LAYOUT_APPROVAL")
    if awaiting_ord < 0 or awaiting_ord >= current_ord:
        return []
    ledger_data = load_ledger(feature_dir)
    if not ledger_data:
        return []
    artifact = load_artifact(feature_dir, MILESTONES["UI_LAYOUT"]["artifact_path"])
    if artifact is None:
        return []
    stale = []
    for slice_id in ui_slices_with_layout(artifact):
        rec = find_ui_layout_approval(ledger_data, slice_id)
        if not rec:
            continue
        if rec.get("status") == "STALE":
            stale.append(slice_id)
            continue
        if rec.get("status") != "APPROVED":
            continue
        if slice_ui_layout_digest(artifact, slice_id) != rec.get("approved_digest"):
            stale.append(slice_id)
    return stale


