# A rollback whose scope is derivable keeps every upstream artifact registered: only the
# evidence of the affected slices is invalidated, and the gates re-check everything on re-advance.
SCOPED_INVALIDATED_ARTIFACTS = ["stage_4_milestone_evidence", "stage_5_delivery_report"]
EXECUTIONS_PATH = "milestones/executions.json"
EVIDENCE_SUMMARY_PATH = "milestones/evidence-summary.json"
INVALIDATED_EXECUTIONS_PATH = "milestones/invalidated-executions.json"


def now_iso_utc():
    """Return current UTC timestamp in ISO-8601 format."""
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def resolve_feature_dir(slug, dir_override=None, root_override=None):
    """Resolve the directory holding state.json and stage artifacts."""
    if dir_override:
        return Path(dir_override).resolve()

    if root_override:
        root_path = Path(root_override).resolve()
        if (root_path / ".verified-feature-delivery" / slug).exists():
            return root_path / ".verified-feature-delivery" / slug
        if (root_path / slug).exists():
            return root_path / slug
        return root_path / ".verified-feature-delivery" / slug

    cwd = Path.cwd()
    # Check default project-local location
    candidate = cwd / ".verified-feature-delivery" / slug
    if candidate.exists():
        return candidate

    # Check test fixture directories
    repo_root = Path(__file__).resolve().parent.parent.parent.parent
    fixtures_dir = repo_root / "skills" / "verified-feature-delivery" / "tests" / "cases" / "scaffold" / "fixtures" / slug
    if fixtures_dir.exists():
        return fixtures_dir

    return candidate


def load_state(feature_dir):
    """Load state.json from feature_dir or return None if absent."""
    state_file = feature_dir / "state.json"
    if not state_file.is_file():
        return None
    try:
        with open(state_file, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception as e:
        sys.stderr.write("Failed to parse state.json: %s\n" % e)
        return None


def save_state(feature_dir, state_data):
    """Save state_data to state.json in feature_dir."""
    feature_dir.mkdir(parents=True, exist_ok=True)
    state_file = feature_dir / "state.json"
    with open(state_file, "w", encoding="utf-8") as f:
        json.dump(state_data, f, indent=2)
        f.write("\n")


def cmd_init(args):
    """Initialize state.json at UNINITIALIZED for a given feature."""
    feature_dir = resolve_feature_dir(args.feature, args.dir, args.root)
    state_data = {
        "schema_version": "1.0.0",
        "feature_slug": args.feature,
        "current_state": "UNINITIALIZED",
        "updated_at": now_iso_utc(),
        "artifacts": dict(DEFAULT_ARTIFACT_MAP),
        "history": [
            {
                "from_state": None,
                "to_state": "UNINITIALIZED",
                "transition_type": "INIT",
                "timestamp": now_iso_utc(),
                "gate_artifact_verified": None,
                "rollback_cause": None,
            }
        ],
    }
    lane = getattr(args, "lane", None) or "NEW_CAPABILITY"
    state_data["lane"] = lane
    baseline_dir = getattr(args, "baseline_dir", None)
    seeded = None
    if baseline_dir:
        _skill_lib()
        from lib.baseline import BaselineError, seed_feature_from_baseline
        root = Path(args.root).resolve() if getattr(args, "root", None) else Path.cwd()
        baseline_path = Path(baseline_dir)
        if not baseline_path.is_absolute():
            baseline_path = root / baseline_path
        if not (baseline_path / "baseline.json").is_file():
            print("BASELINE_NOT_FOUND")
            sys.stderr.write("BASELINE_NOT_FOUND: no baseline.json under %s; nothing was written\n"
                             % baseline_path)
            return 1
        if not args.dry_run:
            try:
                seeded = seed_feature_from_baseline(baseline_path, feature_dir)
            except BaselineError as error:
                print(error.code)
                sys.stderr.write("%s\n" % error)
                return 1
        state_data["baseline"] = {
            "dir": str(baseline_dir),
            "reused_boundary_classes": (seeded or {}).get("reused_boundary_classes", []),
        }
    if not args.dry_run:
        save_state(feature_dir, state_data)
    print("INITIALIZED: %s at UNINITIALIZED (lane %s)" % (args.feature, lane))
    if seeded is not None:
        reused = seeded["reused_boundary_classes"]
        print("BASELINE_SEEDED: lexicon %s; Stage 1 reuses %s"
              % ("copied" if seeded["lexicon_seeded"] else "kept",
                 ", ".join(reused) if reused else "no boundary class (every class is probed)"))
    print(json.dumps(state_data, indent=2))
    return 0


def cmd_show(args):
    """Display current state and recorded artifacts."""
    feature_dir = resolve_feature_dir(args.feature, args.dir, args.root)
    state_data = load_state(feature_dir)
    if not state_data:
        sys.stderr.write("State file missing at %s\n" % (feature_dir / "state.json"))
        return 1
    print(json.dumps(state_data, indent=2))
    return 0


def cmd_advance(args):
    """Advance feature to next state if transition is legal and gate artifact exists."""
    feature_dir = resolve_feature_dir(args.feature, args.dir, args.root)
    state_data = load_state(feature_dir)

    if not state_data:
        sys.stderr.write("Feature state not found or uninitialized: %s\n" % (feature_dir / "state.json"))
        return 1

    recorded_state = state_data.get("current_state")
    if not recorded_state:
        sys.stderr.write("Invalid state.json: current_state missing\n")
        return 1

    # Assert source state if --from was specified
    if args.from_state:
        if args.from_state != recorded_state:
            print("STATE_ASSERTION_MISMATCH")
            sys.stderr.write(
                "STATE_ASSERTION_MISMATCH: asserted --from state %r does not match recorded current_state %r in %s\n"
                % (args.from_state, recorded_state, feature_dir / "state.json")
            )
            return 1

    current_state = recorded_state
    target_state = args.to_state

    # 0a. A milestone approved in the past whose artifact has since drifted
    # invalidates loudly: the record goes STALE, its rendered documents are
    # deleted, and the feature is pulled back to that milestone's gate --
    # regardless of what target was requested.
    #
    # Order is load-bearing for crash recovery: the state transition is saved first, then the
    # ledger, then the derived documents are removed best-effort. A crash between any two steps
    # leaves the feature at the awaiting gate (where record-approval works) or leaves a STALE
    # record that find_stale_milestone still routes back to that gate on the next advance.
    stale_id = find_stale_milestone(feature_dir, state_data)
    if stale_id:
        meta = MILESTONES[stale_id]
        stale_elements = stale_element_ids(feature_dir, stale_id)
        prev_state = state_data["current_state"]
        if prev_state != meta["awaiting_state"]:
            state_data["current_state"] = meta["awaiting_state"]
            state_data["updated_at"] = now_iso_utc()
            state_data.setdefault("history", []).append(
                {
                    "from_state": prev_state,
                    "to_state": meta["awaiting_state"],
                    "transition_type": "STALE_INVALIDATION",
                    "timestamp": now_iso_utc(),
                    "gate_artifact_verified": None,
                    "rollback_cause": stale_id,
                }
            )
            if not args.dry_run:
                save_state(feature_dir, state_data)
        if not args.dry_run:
            ledger_data = load_ledger(feature_dir)
            if ledger_data:
                mark_approval_stale(feature_dir, ledger_data, stale_id, stale_elements)
            delete_derived_docs(feature_dir, meta["derived_docs"])
        print("STALE_APPROVAL_INVALIDATED")
        if stale_elements:
            print("STALE_ELEMENTS: %s" % ", ".join(stale_elements))
        sys.stderr.write(
            "STALE_APPROVAL_INVALIDATED: %s approval no longer matches the current content of "
            "%s; record marked STALE, its rendered documents deleted, and the feature returned "
            "to %s. %s Re-run bin/record-approval to re-open the path.\n"
            % (
                stale_id, meta["artifact_path"], meta["awaiting_state"],
                ("Only these elements changed since approval and need review: %s."
                 % ", ".join(stale_elements)) if stale_elements else
                "The record predates element-scoped approvals, so the whole section needs review.",
            )
        )
        return 1

    # 0a2. UI_LAYOUT staleness, per slice (improvement plan §5.1 applied at §5.2's scope): a
    # slice's ui_layout edited after its own approval invalidates only that slice's record and
    # deletes only that slice's mockup, regardless of what other UI slices in the same feature
    # are still approved.
    # Same save order as above: state, then ledger, then the derived mockups.
    stale_ui_slices = find_stale_ui_layout_slices(feature_dir, state_data)
    if stale_ui_slices:
        prev_state = state_data["current_state"]
        awaiting = "AWAITING_UI_LAYOUT_APPROVAL"
        if prev_state != awaiting:
            state_data["current_state"] = awaiting
            state_data["updated_at"] = now_iso_utc()
            state_data.setdefault("history", []).append(
                {
                    "from_state": prev_state,
                    "to_state": awaiting,
                    "transition_type": "STALE_INVALIDATION",
                    "timestamp": now_iso_utc(),
                    "gate_artifact_verified": None,
                    "rollback_cause": "UI_LAYOUT:" + ",".join(stale_ui_slices),
                }
            )
            if not args.dry_run:
                save_state(feature_dir, state_data)
        if not args.dry_run:
            ledger_data = load_ledger(feature_dir)
            if ledger_data:
                for slice_id in stale_ui_slices:
                    mark_ui_layout_stale(ledger_data, slice_id)
                save_ledger(feature_dir, ledger_data)
            for slice_id in stale_ui_slices:
                delete_ui_mockup(feature_dir, slice_id)
        print("STALE_APPROVAL_INVALIDATED")
        sys.stderr.write(
            "STALE_APPROVAL_INVALIDATED: UI_LAYOUT approval for slice(s) %s no longer matches "
            "the current content of their ui_layout; record(s) marked STALE, their mockups "
            "deleted, and the feature returned to %s. Re-run bin/record-approval --milestone "
            "UI_LAYOUT --slice <slice_id> for each to re-open the path.\n"
            % (", ".join(stale_ui_slices), awaiting)
        )
        return 1

    # 0b. An awaiting-approval state can only be left by a matching, digest-valid
    # APPROVED record for the milestone it guards. advance never grants this
    # itself -- not to the stage after it, not to the next awaiting state --
    # because a human gate the authoring agent can walk through is not a gate.
    #
    # UI_LAYOUT is scoped per slice rather than to the whole artifact (improvement plan §5.2):
    # every slice that declares a ui_layout needs its own APPROVED, digest-valid record before
    # Stage 4 may run, not one record for the feature.
    awaiting_milestone = AWAITING_STATE_TO_MILESTONE.get(current_state)
    if awaiting_milestone == "UI_LAYOUT":
        artifact = load_artifact(feature_dir, MILESTONES["UI_LAYOUT"]["artifact_path"])
        ledger_data = load_ledger(feature_dir)
        slice_ids = ui_slices_with_layout(artifact) if artifact is not None else []
        unapproved = []
        for slice_id in slice_ids:
            rec = find_ui_layout_approval(ledger_data, slice_id)
            digest = slice_ui_layout_digest(artifact, slice_id) if artifact is not None else None
            if not rec or rec.get("status") != "APPROVED" or digest is None or digest != rec.get("approved_digest"):
                unapproved.append(slice_id)
        if unapproved:
            print("AWAITING_APPROVAL")
            sys.stderr.write(
                "AWAITING_APPROVAL: UI_LAYOUT has no APPROVED, digest-valid record for slice(s) "
                "%s; run bin/record-approval --milestone UI_LAYOUT --slice <slice_id> for each "
                "before advancing\n" % ", ".join(unapproved)
            )
            return 1
    elif awaiting_milestone:
        meta = MILESTONES[awaiting_milestone]
        ledger_data = load_ledger(feature_dir)
        rec = find_approval(ledger_data, awaiting_milestone)
        if not rec or rec.get("status") != "APPROVED":
            print("AWAITING_APPROVAL")
            sys.stderr.write(
                "AWAITING_APPROVAL: %s has no APPROVED record for milestone %s; run "
                "bin/record-approval, a separate executable, before advancing\n"
                % (current_state, awaiting_milestone)
            )
            return 1
        artifact = load_artifact(feature_dir, meta["artifact_path"])
        digest = canonical_digest(artifact, meta["digest_scope"]) if artifact is not None else None
        if digest is None or digest != rec.get("approved_digest"):
            print("AWAITING_APPROVAL")
            sys.stderr.write(
                "AWAITING_APPROVAL: recomputed digest for milestone %s does not match the "
                "stored approved_digest; a stored status of APPROVED is never sufficient on its "
                "own\n" % awaiting_milestone
            )
            return 1

    # 1. Validate source state
    if current_state not in TRANSITION_TABLE:
        print("INVALID_STAGE_TRANSITION")
        sys.stderr.write("INVALID_STAGE_TRANSITION: unknown source state %r\n" % current_state)
        return 1

    # 2. Validate transition adherence in Section 4 table
    allowed_next = TRANSITION_TABLE[current_state]["allowed_next"]
    if target_state not in allowed_next:
        print("INVALID_STAGE_TRANSITION")
        sys.stderr.write(
            "INVALID_STAGE_TRANSITION: transition from %s to %s is not permitted in §4 table. Allowed next: %s\n"
            % (current_state, target_state, ", ".join(allowed_next) if allowed_next else "None")
        )
        return 1

    # 3. Validate required gate exit artifact
    req_path = TRANSITION_TABLE[current_state]["required_artifact_path"]
    req_key = TRANSITION_TABLE[current_state]["required_artifact_key"]
    verified_artifact = None

    # Refuse non-authoritative artifacts entries in state.json
    artifacts = state_data.get("artifacts", {})
    if isinstance(artifacts, dict):
        for k, v in artifacts.items():
            if k in DEFAULT_ARTIFACT_MAP and v is not None and v != DEFAULT_ARTIFACT_MAP[k]:
                print("GATE_ARTIFACT_PATH_NOT_AUTHORITATIVE")
                sys.stderr.write(
                    "GATE_ARTIFACT_PATH_NOT_AUTHORITATIVE: state.json artifacts[%r] = %r disagrees with authoritative path %r\n"
                    % (k, v, DEFAULT_ARTIFACT_MAP[k])
                )
                return 1

    if req_path:
        artifact_file = feature_dir / req_path
        if not artifact_file.is_file():
            print("MISSING_GATE_ARTIFACT")
            sys.stderr.write(
                "MISSING_GATE_ARTIFACT: exit artifact for %s is missing at %s\n"
                % (current_state, artifact_file)
            )
            return 1
        verified_artifact = req_path

    # 3b. Validate required human-readable stage documents
    required_stage_docs = {
        "STAGE_0_DOMAIN_INGESTION": [
            ("docs/ubiquitous-language-glossary.md", "domain-lexicon.json"),
            ("docs/domain-entity-map.md", "domain-lexicon.json"),
        ],
        "STAGE_2_SCENARIO_SIMULATION": [
            ("docs/flow-simulation.md", "flow-simulation-matrix.json"),
        ],
        "STAGE_3_VERTICAL_SLICING": [
            ("docs/vertical-slice-plan.md", "execution-dag.json"),
        ],
    }
    req_docs = required_stage_docs.get(current_state, [])
    for doc_rel, src_rel in req_docs:
        doc_file = feature_dir / doc_rel
        if not doc_file.is_file() or doc_file.stat().st_size == 0:
            print("MISSING_STAGE_DOCUMENT")
            sys.stderr.write(
                "MISSING_STAGE_DOCUMENT: required human-readable document %s is missing or empty for %s at %s\n"
                % (doc_rel, current_state, doc_file)
            )
            return 1
        src_file = feature_dir / src_rel
        if src_file.is_file():
            if doc_file.stat().st_mtime < src_file.stat().st_mtime - 1.0:
                print("STALE_STAGE_DOCUMENT")
                sys.stderr.write(
                    "STALE_STAGE_DOCUMENT: human-readable document %s is older than source artifact %s\n"
                    % (doc_rel, src_rel)
                )
                return 1

    # 3c. Gate the STAGE_5_DELIVERY -> COMPLETED transition on evidence verification passing
    if current_state == "STAGE_5_DELIVERY" and target_state == "COMPLETED":
        delivery_json = feature_dir / "delivery-report.json"
        dag_json = feature_dir / "execution-dag.json"
        if delivery_json.is_file() and dag_json.is_file():
            skill_root = str(Path(__file__).resolve().parent.parent)
            if skill_root not in sys.path:
                sys.path.insert(0, skill_root)
            try:
                from lib.delivery import (
                    read_report,
                    read_planned_milestones,
                    lint_intent,
                    lint_abstraction,
                    check_gates,
                    verify_medium,
                    verify_claim,
                    live_observation_scope,
                )
                report, rep_problems = read_report(delivery_json)
                if rep_problems:
                    token = rep_problems[0].split(":")[0].strip()
                    print(token)
                    sys.stderr.write("EVIDENCE_VERIFICATION_FAILED: %s\n" % rep_problems[0])
                    return 1
                planned, plan_problems = read_planned_milestones(dag_json)
                if plan_problems:
                    token = plan_problems[0].split(":")[0].strip()
                    print(token)
                    sys.stderr.write("EVIDENCE_VERIFICATION_FAILED: %s\n" % plan_problems[0])
                    return 1
                for check in (lint_intent, lint_abstraction, check_gates):
                    chk_problems = check(report)
                    if chk_problems:
                        token = chk_problems[0].split(":")[0].strip()
                        print(token)
                        sys.stderr.write("EVIDENCE_VERIFICATION_FAILED: %s\n" % chk_problems[0])
                        return 1
                verified, med_problems = verify_medium(report, planned, feature_dir)
                if med_problems:
                    token = med_problems[0].split(":")[0].strip()
                    print(token)
                    sys.stderr.write("EVIDENCE_VERIFICATION_FAILED: %s\n" % med_problems[0])
                    return 1
                _notes, claim_problems = verify_claim(
                    report, planned, verified, base_dir=feature_dir,
                    observe_milestones=live_observation_scope(state_data))
                if claim_problems:
                    token = claim_problems[0].split(":")[0].strip()
                    print(token)
                    sys.stderr.write("EVIDENCE_VERIFICATION_FAILED: %s\n" % claim_problems[0])
                    return 1
            except Exception as ex:
                sys.stderr.write("Error running evidence verification: %s\n" % ex)
                print("EVIDENCE_VERIFICATION_ERROR")
                return 1

    # 4. Apply state advance
    state_data["current_state"] = target_state
    state_data["updated_at"] = now_iso_utc()
    state_data.setdefault("history", []).append(
        {
            "from_state": current_state,
            "to_state": target_state,
            "transition_type": "ADVANCE",
            "timestamp": now_iso_utc(),
            "gate_artifact_verified": verified_artifact,
            "rollback_cause": None,
        }
    )

    if not args.dry_run:
        save_state(feature_dir, state_data)

    print("ADVANCED: %s -> %s" % (current_state, target_state))
    return 0


def cmd_rollback(args):
    """Execute regression rollback routing from Stage 4 with specified cause."""
    feature_dir = resolve_feature_dir(args.feature, args.dir, args.root)
    state_data = load_state(feature_dir)

    if not state_data:
        sys.stderr.write("Feature state not found or uninitialized: %s\n" % (feature_dir / "state.json"))
        return 1

    recorded_state = state_data.get("current_state")
    if not recorded_state:
        sys.stderr.write("Invalid state.json: current_state missing\n")
        return 1

    # Assert source state if --from was specified
    if args.from_state:
        if args.from_state != recorded_state:
            print("STATE_ASSERTION_MISMATCH")
            sys.stderr.write(
                "STATE_ASSERTION_MISMATCH: asserted --from state %r does not match recorded current_state %r in %s\n"
                % (args.from_state, recorded_state, feature_dir / "state.json")
            )
            return 1

    current_state = recorded_state
    target_state = args.to_state
    cause = args.cause

    if current_state not in TRANSITION_TABLE:
        print("INVALID_STAGE_TRANSITION")
        sys.stderr.write("INVALID_STAGE_TRANSITION: unknown source state %r\n" % current_state)
        return 1

    allowed_rollbacks = TRANSITION_TABLE[current_state].get("allowed_rollback_targets", {})
    if target_state not in allowed_rollbacks:
        print("INVALID_STAGE_TRANSITION")
        sys.stderr.write(
            "INVALID_STAGE_TRANSITION: rollback from %s to %s is not permitted. Allowed rollback targets: %s\n"
            % (current_state, target_state, ", ".join(allowed_rollbacks.keys()) if allowed_rollbacks else "None")
        )
        return 1

    allowed_causes = allowed_rollbacks[target_state]
    if cause not in allowed_causes:
        print("INVALID_STAGE_TRANSITION")
        sys.stderr.write(
            "INVALID_STAGE_TRANSITION: rollback cause %r is invalid for target %s. Allowed causes: %s\n"
            % (cause, target_state, ", ".join(allowed_causes))
        )
        return 1

    scope, scope_problem = derive_rollback_scope(feature_dir, args)

    # Invalidate downstream artifacts: all of them when the scope is underivable (the safe
    # default), only the evidence of the affected slices when it is.
    invalidated = (
        SCOPED_INVALIDATED_ARTIFACTS if scope else STAGE_INVALIDATED_ARTIFACTS.get(target_state, [])
    )
    if "artifacts" in state_data:
        for art_key in invalidated:
            if art_key in state_data["artifacts"]:
                state_data["artifacts"][art_key] = None
    if scope:
        # Scoped rollbacks before the next delivery accumulate: every slice any of them
        # invalidated must be re-run and re-observed.
        previous = state_data.get("rollback_scope")
        if isinstance(previous, dict):
            scope = {key: sorted(set(scope[key]) | set(previous.get(key) or []))
                     for key in ("elements", "slices", "milestones")}
        state_data["rollback_scope"] = dict(scope, cause=cause, timestamp=now_iso_utc())
    else:
        state_data.pop("rollback_scope", None)

    state_data["current_state"] = target_state
    state_data["updated_at"] = now_iso_utc()
    state_data.setdefault("history", []).append(
        {
            "from_state": current_state,
            "to_state": target_state,
            "transition_type": "ROLLBACK",
            "timestamp": now_iso_utc(),
            "gate_artifact_verified": None,
            "rollback_cause": cause,
        }
    )

    if not args.dry_run:
        save_state(feature_dir, state_data)
        if scope:
            invalidate_slice_evidence(feature_dir, scope["milestones"], cause)

    print("ROLLED_BACK: %s -> %s (cause: %s)" % (current_state, target_state, cause))
    if scope:
        print("ROLLBACK_SCOPE: elements=%s slices=%s" % (
            ",".join(scope["elements"]), ",".join(scope["slices"])))
        sys.stderr.write(
            "ROLLBACK_SCOPE: upstream artifacts kept; evidence invalidated only for milestone(s) "
            "%s of the affected slice(s). Every gate still re-checks on re-advance.\n"
            % (", ".join(scope["milestones"]) or "none")
        )
    else:
        print("ROLLBACK_SCOPE_UNDERIVABLE")
        sys.stderr.write(
            "ROLLBACK_SCOPE_UNDERIVABLE: %s; every downstream artifact of %s was invalidated.\n"
            % (scope_problem, target_state)
        )
    return 0


def derive_rollback_scope(feature_dir, args):
    """(scope, None) when the regression names elements the DAG's slices reference, else
    (None, why). The scope comes from lib/rollback.rollback_scope; this only gathers inputs."""
    milestone_id = getattr(args, "scope_milestone", None)
    trace = getattr(args, "scope_trace", None)
    trace_file = getattr(args, "trace", None)
    if trace_file:
        try:
            data = json.loads(Path(trace_file).read_text(encoding="utf-8"))
        except (OSError, ValueError) as error:
            return None, "the failure trace %s is unreadable (%s)" % (trace_file, error)
        if not isinstance(data, dict):
            return None, "the failure trace %s is not an object" % trace_file
        milestone_id = data.get("milestone_id")
        trace = data.get("trace")
    if not milestone_id and not trace:
        return None, "no failure trace was given, so the affected elements cannot be derived"
    dag = load_artifact(feature_dir, "execution-dag.json")
    lexicon = load_artifact(feature_dir, "domain-lexicon.json")
    _skill_lib()
    from lib.rollback import rollback_scope
    scope = rollback_scope(milestone_id, trace, lexicon, dag)
    if scope is None:
        return None, "the failure trace names nothing any slice of execution-dag.json references"
    return scope, None


def invalidate_slice_evidence(feature_dir, milestone_ids, cause):
    """Move the affected milestones' execution records aside and retire the evidence summary.

    Records of unaffected slices stay in milestones/executions.json, so the harness re-grades them
    unchanged once the affected slices are re-run. Nothing is deleted: moved records are appended
    to milestones/invalidated-executions.json and the summary is renamed, both for audit.
    """
    affected = set(milestone_ids)
    executions_file = feature_dir / EXECUTIONS_PATH
    executions = load_artifact(feature_dir, EXECUTIONS_PATH)
    if isinstance(executions, dict) and isinstance(executions.get("milestones"), list):
        kept, moved = [], []
        for record in executions["milestones"]:
            is_affected = isinstance(record, dict) and str(record.get("milestone_id")) in affected
            (moved if is_affected else kept).append(record)
        if moved:
            ledger = load_artifact(feature_dir, INVALIDATED_EXECUTIONS_PATH)
            if not isinstance(ledger, dict) or not isinstance(ledger.get("invalidated"), list):
                ledger = {"schema_version": "1.0.0", "invalidated": []}
            ledger["invalidated"].append(
                {"cause": cause, "timestamp": now_iso_utc(), "milestones": moved})
            (feature_dir / INVALIDATED_EXECUTIONS_PATH).write_text(
                json.dumps(ledger, indent=2) + "\n", encoding="utf-8")
            executions["milestones"] = kept
            executions_file.write_text(json.dumps(executions, indent=2) + "\n", encoding="utf-8")
    summary = feature_dir / EVIDENCE_SUMMARY_PATH
    if summary.is_file():
        summary.replace(summary.with_name("evidence-summary.invalidated.json"))


def cmd_status(args):
    """Display deterministic lifecycle status, gate readiness, and progress."""
    feature_dir = resolve_feature_dir(args.feature, args.dir, args.root)
    state_data = load_state(feature_dir)
    if not state_data:
        sys.stderr.write("State file missing at %s\n" % (feature_dir / "state.json"))
        return 1

    current_state = state_data.get("current_state", "UNINITIALIZED")
    ord_idx = state_ordinal(current_state)

    req_path = TRANSITION_TABLE.get(current_state, {}).get("required_artifact_path")
    gate_artifact_present = bool(req_path and (feature_dir / req_path).is_file())

    awaiting_milestone = AWAITING_STATE_TO_MILESTONE.get(current_state)

    milestone_summary = load_artifact(feature_dir, "milestones/evidence-summary.json")
    completed_milestones = (
        milestone_summary.get("milestones_verified", [])
        if isinstance(milestone_summary, dict)
        else []
    )

    status_obj = {
        "schema_version": "1.0.0",
        "feature_slug": args.feature,
        "current_state": current_state,
        "ordinal": ord_idx,
        "total_stages": len(STATE_ORDER) - 1,
        "gate_artifact_required": req_path,
        "gate_artifact_present": gate_artifact_present,
        "awaiting_approval": awaiting_milestone,
        "completed_milestones": completed_milestones,
        "updated_at": state_data.get("updated_at"),
    }

    if getattr(args, "json", False):
        print(json.dumps(status_obj, indent=2))
    else:
        print("Feature: %s" % args.feature)
        print("Current State: %s (Stage %d/%d)" % (current_state, ord_idx, len(STATE_ORDER) - 1))
        print("Gate Exit Artifact: %s (%s)" % (
            req_path or "None",
            "PRESENT" if gate_artifact_present else ("MISSING" if req_path else "N/A"),
        ))
        if awaiting_milestone:
            print("Awaiting Approval: %s" % awaiting_milestone)
        if completed_milestones:
            print("Completed Milestones: %s" % ", ".join(completed_milestones))
    return 0


def cmd_next_action(args):
    """Determine deterministic next action for the driver or supervisor."""
    feature_dir = resolve_feature_dir(args.feature, args.dir, args.root)
    state_data = load_state(feature_dir)
    if not state_data:
        sys.stderr.write("State file missing at %s\n" % (feature_dir / "state.json"))
        return 1

    current_state = state_data.get("current_state", "UNINITIALIZED")
    action_obj: Dict[str, Any] = {}

    if current_state == "UNINITIALIZED":
        action_obj = {
            "action": "INIT_STAGE_0",
            "guide": "phases/0-domain-ingestion/guide.md",
            "command": "python3 bin/planner-state advance --feature %s --to STAGE_0_DOMAIN_INGESTION" % args.feature,
            "description": "Advance to Stage 0 to ingest domain taxonomy, lock precisions, and register actors/observers.",
        }
    elif current_state == "STAGE_0_DOMAIN_INGESTION":
        lex_file = feature_dir / "domain-lexicon.json"
        if not lex_file.is_file():
            action_obj = {
                "action": "AUTHOR_DOMAIN_LEXICON",
                "guide": "phases/0-domain-ingestion/guide.md",
                "target_file": "domain-lexicon.json",
                "command": "python3 bin/validate-lexicon %s" % lex_file,
                "description": "Author domain-lexicon.json declaring entities, value objects, precisions, and actors.",
            }
        else:
            action_obj = {
                "action": "ADVANCE_TO_STAGE_1",
                "guide": "phases/1-contract-probing/guide.md",
                "command": "python3 bin/planner-state advance --feature %s --to STAGE_1_CONTRACT_PROBING" % args.feature,
                "description": "Advance to Stage 1 Contract Probing.",
            }
    elif current_state == "STAGE_1_CONTRACT_PROBING":
        manifest_file = feature_dir / "contract-fixtures" / "manifest.json"
        if not manifest_file.is_file():
            action_obj = {
                "action": "PROBE_CONTRACT_BOUNDARIES",
                "guide": "phases/1-contract-probing/guide.md",
                "target_file": "contract-fixtures/manifest.json",
                "command": "python3 bin/verify-fixture-variance %s" % manifest_file,
                "description": "Probe external boundary classes and capture contract fixtures.",
            }
        else:
            action_obj = {
                "action": "ADVANCE_TO_STAGE_2",
                "guide": "phases/2-scenario-simulation/guide.md",
                "command": "python3 bin/planner-state advance --feature %s --to STAGE_2_SCENARIO_SIMULATION" % args.feature,
                "description": "Advance to Stage 2 Scenario Simulation.",
            }
    elif current_state == "STAGE_2_SCENARIO_SIMULATION":
        matrix_file = feature_dir / "flow-simulation-matrix.json"
        if not matrix_file.is_file():
            action_obj = {
                "action": "AUTHOR_SCENARIO_MATRIX",
                "guide": "phases/2-scenario-simulation/guide.md",
                "target_file": "flow-simulation-matrix.json",
                "command": "python3 bin/validate-scenario-matrix %s" % matrix_file,
                "description": "Author flow-simulation-matrix.json covering branch groups A & B.",
            }
        else:
            action_obj = {
                "action": "ADVANCE_TO_FLOW_APPROVAL",
                "command": "python3 bin/planner-state advance --feature %s --to AWAITING_FLOW_SIMULATION_APPROVAL" % args.feature,
                "description": "Advance to AWAITING_FLOW_SIMULATION_APPROVAL gate.",
            }
    elif current_state in ("AWAITING_FLOW_SIMULATION_APPROVAL", "AWAITING_ENTITY_BOUNDARIES_APPROVAL", "AWAITING_UI_LAYOUT_APPROVAL"):
        milestone_id = AWAITING_STATE_TO_MILESTONE.get(current_state)
        action_obj = {
            "action": "RECORD_APPROVAL_%s" % milestone_id,
            "milestone_id": milestone_id,
            "command": "python3 bin/record-approval --milestone %s" % milestone_id,
            "description": "Record independent human approval for %s." % milestone_id,
        }
    elif current_state == "STAGE_3_VERTICAL_SLICING":
        dag_file = feature_dir / "execution-dag.json"
        if not dag_file.is_file():
            action_obj = {
                "action": "AUTHOR_EXECUTION_DAG",
                "guide": "phases/3-vertical-slicing/guide.md",
                "target_file": "execution-dag.json",
                "command": "python3 bin/validate-execution-dag %s" % dag_file,
                "description": "Author execution-dag.json defining vertical tracer-bullet slices.",
            }
        else:
            action_obj = {
                "action": "ADVANCE_TO_UI_APPROVAL",
                "command": "python3 bin/planner-state advance --feature %s --to AWAITING_UI_LAYOUT_APPROVAL" % args.feature,
                "description": "Advance to AWAITING_UI_LAYOUT_APPROVAL gate.",
            }
    elif current_state == "STAGE_4_MILESTONE_EXECUTION":
        evidence_summary = feature_dir / "milestones" / "evidence-summary.json"
        if not evidence_summary.is_file():
            action_obj = {
                "action": "EXECUTE_MILESTONES",
                "guide": "phases/4-milestone-execution/guide.md",
                "command": "python3 bin/milestone-harness %s" % feature_dir,
                "description": "Dispatch worker agents to execute slices and generate evidence captures.",
            }
        else:
            action_obj = {
                "action": "ADVANCE_TO_STAGE_5",
                "guide": "phases/5-process-delivery/guide.md",
                "command": "python3 bin/planner-state advance --feature %s --to STAGE_5_DELIVERY" % args.feature,
                "description": "Advance to Stage 5 Delivery.",
            }
    elif current_state == "STAGE_5_DELIVERY":
        rep_file = feature_dir / "delivery-report.md"
        if not rep_file.is_file():
            action_obj = {
                "action": "GENERATE_DELIVERY_REPORT",
                "guide": "phases/5-process-delivery/guide.md",
                "target_file": "delivery-report.md",
                "command": "python3 bin/verify-evidence %s" % feature_dir,
                "description": "Verify all evidence axes and emit delivery report.",
            }
        else:
            action_obj = {
                "action": "ADVANCE_TO_COMPLETED",
                "command": "python3 bin/planner-state advance --feature %s --to COMPLETED" % args.feature,
                "description": "Complete verified feature delivery.",
            }
    elif current_state == "COMPLETED":
        action_obj = {
            "action": "COMPLETE",
            "description": "Feature delivery complete. All verification obligations met.",
        }

    if getattr(args, "json", False):
        print(json.dumps(action_obj, indent=2))
    else:
        print("Next Action: %s" % action_obj.get("action"))
        print("Description: %s" % action_obj.get("description"))
        if action_obj.get("command"):
            print("Command: %s" % action_obj.get("command"))
        if action_obj.get("guide"):
            print("Guide: %s" % action_obj.get("guide"))
    return 0


def cmd_sidecar(args):
    """Generate or view slice sidecar state for scoped worker context."""
    feature_dir = resolve_feature_dir(args.feature, args.dir, args.root)
    skill_root = str(Path(__file__).resolve().parent.parent)
    if skill_root not in sys.path:
        sys.path.insert(0, skill_root)

    from lib.sidecar import build_slice_sidecar
    out_path = Path(args.out).resolve() if args.out else None
    diff_files = [f.strip() for f in args.diff.split(",") if f.strip()] if getattr(args, "diff", None) else None
    try:
        sidecar_data = build_slice_sidecar(feature_dir, args.slice_id, out_path, diff_files=diff_files)
        print(json.dumps(sidecar_data, indent=2))
        return 0
    except Exception as e:
        sys.stderr.write("Failed to generate sidecar: %s\n" % e)
        return 1


def cmd_verification_plan(args):
    """Generate and inspect deterministic verification plan for feature / slice."""
    feature_dir = resolve_feature_dir(args.feature, args.dir, args.root)
    skill_root = str(Path(__file__).resolve().parent.parent)
    if skill_root not in sys.path:
        sys.path.insert(0, skill_root)

    from lib.verification_policy import generate_verification_plan, validate_verification_plan

    diff_files = [f.strip() for f in args.diff.split(",") if f.strip()] if getattr(args, "diff", None) else None
    try:
        plan = generate_verification_plan(
            feature_dir=feature_dir,
            slice_id=args.slice_id,
            diff_files=diff_files,
            is_stage_5_exit=getattr(args, "stage_5_exit", False),
        )
        is_valid, token, errors = validate_verification_plan(plan)
        if not is_valid:
            sys.stderr.write("Verification plan validation failed [%s]: %s\n" % (token, errors))
            return 1

        if args.json:
            print(json.dumps(plan, indent=2))
        else:
            print("=== Verification Plan (%s) ===" % plan["escalation_tier"])
            print("Feature: %s | Slice: %s" % (plan["feature_slug"], plan.get("slice_id") or "N/A"))
            print("Mandatory Gatekeeper: %s" % plan["mandatory_gatekeeper"])
            if plan.get("warnings"):
                print("Warnings:")
                for w in plan["warnings"]:
                    print("  [!] %s" % w)
            print("Selected Checks:")
            for sc in plan["selected_checks"]:
                print("  [%s] %s" % (sc["category"], sc["command"]))
                print("      Rationale: %s" % sc["rationale"])
            if plan.get("skipped_checks"):
                print("Skipped Checks (Audited):")
                for sk in plan["skipped_checks"]:
                    print("  [SKIP:%s] %s" % (sk["reason_code"], sk["suite_name"]))
                    print("      Reason: %s" % sk["reason_description"])
        return 0
    except Exception as e:
        sys.stderr.write("Failed to generate verification plan: %s\n" % e)
        return 1


def cmd_evaluate_capsule(args):
    """Evaluate a worker handoff capsule and optionally advance or rollback."""
    feature_dir = resolve_feature_dir(args.feature, args.dir, args.root)
    capsule_path = Path(args.capsule).resolve()
    if not capsule_path.is_file():
        sys.stderr.write("Capsule file not found at %s\n" % capsule_path)
        return 1

    try:
        with open(capsule_path, "r", encoding="utf-8") as f:
            capsule_data = json.load(f)
    except Exception as e:
        sys.stderr.write("Failed to parse capsule JSON: %s\n" % e)
        return 1

    skill_root = str(Path(__file__).resolve().parent.parent)
    if skill_root not in sys.path:
        sys.path.insert(0, skill_root)

    from lib.capsule import evaluate_capsule
    is_valid, token, details = evaluate_capsule(feature_dir, capsule_data)

    if not is_valid:
        print(token)
        sys.stderr.write("CAPSULE_REJECTED [%s]: %s\n" % (token, json.dumps(details)))
        return 1

    print(token)
    print(json.dumps(details, indent=2))
    return 0


def cmd_diagnostics(args):
    """Retrieve raw file-backed diagnostics on demand."""
    feature_dir = resolve_feature_dir(args.feature, args.dir, args.root)
    skill_root = str(Path(__file__).resolve().parent.parent)
    if skill_root not in sys.path:
        sys.path.insert(0, skill_root)

    from lib.capsule import get_diagnostics
    ref = args.ref or (f"diagnostics/{args.task}.log" if args.task else None)
    if not ref:
        sys.stderr.write("Must specify --ref or --task\n")
        return 1
    diag = get_diagnostics(feature_dir, ref)
    if diag is None:
        sys.stderr.write("Diagnostics not found for %s\n" % ref)
        return 1
    print(diag, end="")
    return 0


def build_parser():
    import argparse

    parser = argparse.ArgumentParser(
        description="Agentic Feature Planner - State Transition Engine",
        prog="planner-state",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # init
    p_init = subparsers.add_parser("init", help="Initialize feature state at UNINITIALIZED")
    p_init.add_argument("--feature", required=True, help="Feature slug identifier")
    p_init.add_argument("--dir", help="Explicit target directory for state files")
    p_init.add_argument("--root", help="Project root directory")
    p_init.add_argument("--dry-run", action="store_true", help="Validate without writing state to disk")
    p_init.add_argument("--lane", choices=["TWEAK", "EXTENSION", "NEW_CAPABILITY"], default="NEW_CAPABILITY",
                        help="Change lane from triage-change; sizes the Stage 5 exit tier (default NEW_CAPABILITY)")
    p_init.add_argument("--baseline-dir", help="Seed the feature lexicon and reusable contract fixtures "
                        "from this project baseline (relative to --root or cwd)")

    # show
    p_show = subparsers.add_parser("show", help="Show current state and artifacts")
    p_show.add_argument("--feature", required=True, help="Feature slug identifier")
    p_show.add_argument("--dir", help="Explicit target directory for state files")
    p_show.add_argument("--root", help="Project root directory")

    # status
    p_status = subparsers.add_parser("status", help="Show deterministic status and progress")
    p_status.add_argument("--feature", required=True, help="Feature slug identifier")
    p_status.add_argument("--json", action="store_true", help="Output status as structured JSON")
    p_status.add_argument("--dir", help="Explicit target directory for state files")
    p_status.add_argument("--root", help="Project root directory")

    # next-action
    p_next = subparsers.add_parser("next-action", help="Show deterministic next action")
    p_next.add_argument("--feature", required=True, help="Feature slug identifier")
    p_next.add_argument("--json", action="store_true", help="Output next-action as structured JSON")
    p_next.add_argument("--dir", help="Explicit target directory for state files")
    p_next.add_argument("--root", help="Project root directory")

    # advance
    p_adv = subparsers.add_parser("advance", help="Advance to next stage")
    p_adv.add_argument("--feature", required=True, help="Feature slug identifier")
    p_adv.add_argument("--to", dest="to_state", required=True, help="Target state to advance to")
    p_adv.add_argument("--from", dest="from_state", help="Assert expected source state (fails with STATE_ASSERTION_MISMATCH on disagreement)")
    p_adv.add_argument("--dir", help="Explicit target directory for state files")
    p_adv.add_argument("--root", help="Project root directory")
    p_adv.add_argument("--dry-run", action="store_true", help="Validate without writing state to disk")

    # rollback
    p_rb = subparsers.add_parser("rollback", help="Roll back on regression")
    p_rb.add_argument("--feature", required=True, help="Feature slug identifier")
    p_rb.add_argument("--to", dest="to_state", required=True, help="Target state to roll back to")
    p_rb.add_argument("--cause", required=True, help="Regression trigger cause code")
    p_rb.add_argument("--from", dest="from_state", help="Assert expected source state (fails with STATE_ASSERTION_MISMATCH on disagreement)")
    p_rb.add_argument("--dir", help="Explicit target directory for state files")
    p_rb.add_argument("--root", help="Project root directory")
    p_rb.add_argument("--dry-run", action="store_true", help="Validate without writing state to disk")
    p_rb.add_argument("--trace", help='Failure trace JSON {"milestone_id": ..., "trace": {...}}; scopes '
                      "the rollback to the slices it touches (full invalidation when underivable)")

    # sidecar
    p_sc = subparsers.add_parser("sidecar", help="Generate slice sidecar state for worker")
    p_sc.add_argument("--feature", required=True, help="Feature slug identifier")
    p_sc.add_argument("--slice", dest="slice_id", required=True, help="Target vertical slice ID")
    p_sc.add_argument("--diff", help="Optional comma-separated list of modified file paths")
    p_sc.add_argument("--out", help="Optional output path for sidecar JSON")
    p_sc.add_argument("--dir", help="Explicit target directory for state files")
    p_sc.add_argument("--root", help="Project root directory")

    # verification-plan
    p_vp = subparsers.add_parser("verification-plan", help="Generate deterministic verification plan")
    p_vp.add_argument("--feature", required=True, help="Feature slug identifier")
    p_vp.add_argument("--slice", dest="slice_id", help="Optional target vertical slice ID")
    p_vp.add_argument("--diff", help="Optional comma-separated list of modified file paths")
    p_vp.add_argument("--stage-5-exit", action="store_true", help="Enforce mandatory Stage 5 delivery exit gatekeeper verification")
    p_vp.add_argument("--json", action="store_true", help="Output verification plan as structured JSON")
    p_vp.add_argument("--dir", help="Explicit target directory for state files")
    p_vp.add_argument("--root", help="Project root directory")

    # evaluate-capsule
    p_ec = subparsers.add_parser("evaluate-capsule", help="Evaluate a worker handoff capsule")
    p_ec.add_argument("--feature", required=True, help="Feature slug identifier")
    p_ec.add_argument("--capsule", required=True, help="Path to capsule JSON file")
    p_ec.add_argument("--dir", help="Explicit target directory for state files")
    p_ec.add_argument("--root", help="Project root directory")

    # diagnostics
    p_diag = subparsers.add_parser("diagnostics", help="Retrieve file-backed raw diagnostics")
    p_diag.add_argument("--feature", required=True, help="Feature slug identifier")
    p_diag.add_argument("--task", help="Task / slice ID identifier")
    p_diag.add_argument("--ref", help="Direct relative diagnostics reference path")
    p_diag.add_argument("--dir", help="Explicit target directory for state files")
    p_diag.add_argument("--root", help="Project root directory")

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()
    if args.command == "init":
        return cmd_init(args)
    elif args.command == "show":
        return cmd_show(args)
    elif args.command == "status":
        return cmd_status(args)
    elif args.command == "next-action":
        return cmd_next_action(args)
    elif args.command == "advance":
        return cmd_advance(args)
    elif args.command == "rollback":
        return cmd_rollback(args)
    elif args.command == "sidecar":
        return cmd_sidecar(args)
    elif args.command == "verification-plan":
        return cmd_verification_plan(args)
    elif args.command == "evaluate-capsule":
        return cmd_evaluate_capsule(args)
    elif args.command == "diagnostics":
        return cmd_diagnostics(args)
    else:
        sys.stderr.write("Unknown command: %s\n" % args.command)
        return 1


if __name__ == "__main__":
    sys.exit(main())

