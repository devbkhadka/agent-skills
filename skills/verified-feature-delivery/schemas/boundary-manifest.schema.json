{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BoundaryManifest",
  "description": "Stage 1 Boundary Manifest Schema. Owned by stage-1. Enforces an explicit row for every Boundary Class in the register (PRESENT with probe path or NOT_PRESENT with one-line reason), with per-property verdicts recorded for each present class.",
  "type": "object",
  "required": [
    "schema_version",
    "feature_slug",
    "boundary_classes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema format version (e.g. 1.0.0)."
    },
    "feature_slug": {
      "type": "string",
      "description": "Feature identifier matching the workspace slug."
    },
    "updated_at": {
      "type": "string",
      "description": "ISO-8601 timestamp of last manifest update."
    },
    "boundary_classes": {
      "type": "array",
      "description": "Manifest rows for all 10 canonical boundary classes.",
      "minItems": 10,
      "items": {
        "$ref": "#/definitions/BoundaryClassRow"
      }
    },
    "manifest_rows": {
      "type": "array",
      "description": "Alternative alias for boundary_classes.",
      "items": {
        "$ref": "#/definitions/BoundaryClassRow"
      }
    }
  },
  "definitions": {
    "BoundaryClassRow": {
      "type": "object",
      "required": [
        "class_name",
        "verdict"
      ],
      "properties": {
        "class_name": {
          "type": "string",
          "enum": [
            "SUBPROCESS_CLI",
            "NETWORK_API",
            "FRAMEWORK_MIDDLEWARE",
            "DATASTORE",
            "MESSAGE_TRANSPORT",
            "DEVICE_IO",
            "MODEL_ENDPOINT",
            "UI_RUNTIME",
            "VERIFICATION_HARNESS",
            "OTHER"
          ]
        },
        "verdict": {
          "type": "string",
          "enum": [
            "PRESENT",
            "NOT_PRESENT"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PRESENT",
            "NOT_PRESENT"
          ]
        },
        "probe_path": {
          "type": "string",
          "description": "Relative path to probe script for present classes."
        },
        "absence_reason": {
          "type": "string",
          "description": "Mandatory one-line justification if NOT_PRESENT."
        },
        "reason_if_not_present": {
          "type": "string",
          "description": "Alias for absence_reason."
        },
        "description": {
          "type": "string",
          "description": "Description of boundary (mandatory for OTHER)."
        },
        "amendment_proposal": {
          "type": "string",
          "description": "Register amendment proposal if class is OTHER."
        },
        "properties": {
          "type": "array",
          "description": "Per-property verdicts for present classes.",
          "items": {
            "$ref": "#/definitions/PropertyVerdict"
          }
        }
      }
    },
    "PropertyVerdict": {
      "type": "object",
      "required": [
        "property_name",
        "verdict"
      ],
      "properties": {
        "property_name": {
          "type": "string",
          "description": "Name of the canonical boundary property."
        },
        "verdict": {
          "type": "string",
          "enum": [
            "PROBED",
            "NOT_PRESENT"
          ]
        },
        "fixture_ref": {
          "type": "string",
          "description": "Relative path to interface contract fixture JSON if PROBED."
        },
        "reason_if_not_present": {
          "type": "string",
          "description": "Justification if property is NOT_PRESENT."
        },
        "absence_reason": {
          "type": "string",
          "description": "Alias for reason_if_not_present."
        },
        "probe_target": {
          "type": "string",
          "description": "Optional specific method, endpoint, or command probed."
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
