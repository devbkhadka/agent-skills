  "alias_pairs": [
    {
      "canonical_concept": "CustomerIdentifier",
      "left": {
        "boundary_class": "DATASTORE",
        "token": "stripeCustomerId"
      },
      "right": {
        "boundary_class": "NETWORK_API",
        "token": "customer"
      },
      "mapping_notes": "Prisma model camelCase maps to Stripe API snake_case string customer ID."
    },
    {
      "canonical_concept": "SubscriptionIdentifier",
      "left": {
        "boundary_class": "DATASTORE",
        "token": "stripeSubscriptionId"
      },
      "right": {
        "boundary_class": "NETWORK_API",
        "token": "subscription.id"
      },
      "mapping_notes": "Prisma subscription foreign key maps to Stripe object subscription id."
    }
  ],
  "projection_bindings": [
    {
      "projection_id": "quota_warning_banner",
      "quantity_or_label": "Quota Exceeded Banner Status",
      "observer_id": "OrgAdmin",
      "source_type": "CONTRACT_FIELD",
      "source_reference": "Organization.quota_status",
      "derivation_expression": "Organization.quota_status === 'QUOTA_EXCEEDED' ? 'VISIBLE' : 'HIDDEN'"
    },
    {
      "projection_id": "surplus_seat_count",
      "quantity_or_label": "Locked Surplus Seat Count",
      "observer_id": "OrgAdmin",
      "source_type": "PURE_EXPRESSION",
      "source_reference": "reconcileEntitlements",
      "derivation_expression": "max(0, activeMemberCount - Organization.seat_limit)"
    },
    {
      "projection_id": "member_access_alert",
      "quantity_or_label": "Member Access Permission Alert",
      "observer_id": "OrgMember",
      "source_type": "CONTRACT_FIELD",
      "source_reference": "Organization.quota_status",
      "derivation_expression": "Organization.quota_status === 'QUOTA_EXCEEDED' ? 'LOCKED' : 'UNLOCKED'"
    },
    {
      "projection_id": "system_event_stream",
      "quantity_or_label": "Stripe Event Processing State",
      "observer_id": "SystemMonitor",
      "source_type": "CONTRACT_FIELD",
      "source_reference": "Subscription.status",
      "derivation_expression": "Subscription.status"
    }
  ],
  "value_authorities": [
    {
      "value_name": "proration_amount",
      "authority_model": "UPSTREAM_AUTHORITATIVE",
      "upstream_boundary": "NETWORK_API (Stripe)",
      "local_computation": null,
      "tolerance_epsilon": null,
      "divergence_action": "INGEST_VERBATIM_NEVER_OVERWRITE",
      "rationale": "Stripe performs second-level proration with banker's rounding and tax calculations; local backend never re-asserts."
    }
  ],
  "fact_precedences": [
    {
      "fact_name": "subscription_cancellation_status",
      "primary_boundary": "NETWORK_API (Stripe Webhook)",
      "secondary_boundary": "DATASTORE (Local Database)",
      "precedence_rule": "PRIMARY_WINS_ON_MONOTONIC_TIMESTAMP",
      "reconciliation_check": "Compare event.created > Subscription.last_stripe_event_created; update local record if primary is newer."
    }
  ],
  "dual_computed_values": ["proration_amount"],
  "dual_boundary_facts": ["subscription_cancellation_status"],
