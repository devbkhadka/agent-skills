{
  "schema_version": "1.0.0",
  "feature_slug": "search-console-web-ui",
  "bootstrap_floor": [
    "index.html",
    "src/main.tsx",
    "src/theme.ts",
    "src/App.tsx"
  ],
  "pure_modules": [
    "src/core/buildSearchRequest.ts",
    "src/core/formatResult.ts"
  ],
  "concurrency_budget": {
    "declared_worker_concurrency": 1,
    "probed_boundary_capacity": 10,
    "reserved_headroom": 2
  },
  "locked_dimensions": {
    "1_slicing_topology": {
      "strategy": "SINGLE_TRACER_BULLET_FIRST",
      "slice_1_anchor": "slice_query_to_render",
      "bootstrap_floor": ["index.html", "src/main.tsx", "src/theme.ts", "src/App.tsx"]
    },
    "2_execution_semantics": {
      "mode": "SYNC_REQUEST_RESPONSE"
    },
    "3_state_and_lifecycle": {
      "persistence_model": "EPHEMERAL"
    },
    "4_idempotency_and_ordering": {
      "strategy": "GENERATION_SEQUENCING"
    },
    "5_external_boundaries": {
      "boundary_fixtures": ["contract-fixtures/api.json"]
    },
    "6_observation_and_actor_modality": {
      "primary_observer": "operator",
      "verification_medium": "rendered_ui"
    }
  },
  "slices": [
    {
      "slice_id": "slice_query_to_render",
      "name": "Slice 1: Query Input to Result List Tracer Bullet",
      "dependencies": [],
      "is_slice_1": true,
      "legs": {
        "trigger": {
          "type": "USER_ACTION",
          "description": "Operator enters query string and presses Enter",
          "entry_point": "src/App.tsx#handleSearch"
        },
        "core_pure_logic": {
          "pure_module_files": [
            "src/core/buildSearchRequest.ts",
            "src/core/formatResult.ts"
          ],
          "assertable_without_rendering": true
        },
        "adapter_persistence": {
          "optional_leg_present": true,
          "adapter_files": ["src/api/searchApi.ts"],
          "boundary_class": "NETWORK_API"
        },
        "output_verification": {
          "verification_medium": "rendered_ui",
          "evidence_keys_covered": ["state:RESULTS_POPULATED"],
          "verification_script": "tests/slices/slice_1_verify.sh"
        }
      },
      "actor_modality": {
        "observers": ["operator"],
        "input_modalities": ["pointer", "keyboard"],
        "environment_floor": "narrow_viewport_360px",
        "attention_return": {
          "source_slice": "slice_query_to_render",
          "destination_slice": "slice_query_to_render",
          "focus_target": "input#search-query-field"
        }
      },
      "files_touched": [
        "index.html",
        "src/main.tsx",
        "src/theme.ts",
        "src/App.tsx",
        "src/core/buildSearchRequest.ts",
        "src/core/formatResult.ts",
        "src/api/searchApi.ts",
        "tests/slices/slice_1_verify.sh"
      ],
      "files_read": [
        "index.html",
        "src/main.tsx",
        "src/theme.ts",
        "src/App.tsx"
      ],
      "slice_level": "FLOW",
      "user_visible_outcome": "Search results list rendered for query input",
      "flow_refs": ["flow_search_query"],
      "ui_layout": {
        "layout_status": "APPROVED",
        "source": "AGENT_MOCKUP",
        "figma_node_refs": [],
        "layout_template": "search_results_view",
        "layout_tree": {
          "region": "main",
          "role": "search_results",
          "component": "SearchResultsList",
          "children": []
        }
      }
    }
  ]
}
