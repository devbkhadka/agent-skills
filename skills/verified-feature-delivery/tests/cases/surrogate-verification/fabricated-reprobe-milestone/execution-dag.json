{
  "schema_version": "1.0.0",
  "feature_slug": "monthly-timelog-viewer",
  "locked_dimensions": {
    "1_slicing_topology": {
      "strategy": "SINGLE_TRACER_BULLET_FIRST",
      "slice_1_anchor": "SLICE_1_CORE_TIMELOG_VIEW",
      "bootstrap_floor": [
        "package.json",
        "tsconfig.json",
        "src/server/index.ts",
        "src/client/index.html",
        "src/client/app.ts",
        "src/client/style.css"
      ],
      "disallow_in_slice_1": [
        "src/client/monthSwitch.ts",
        "src/client/errorHandler.ts"
      ]
    },
    "2_execution_semantics": {
      "mode": "ASYNC_EVENT_LOOP",
      "concurrency_model": "SINGLE_THREAD_EVENT_LOOP",
      "drain_and_cancel_barrier": "ABORT_INFLIGHT_ON_NEW_TRIGGER"
    },
    "3_state_and_lifecycle": {
      "persistence_model": "EPHEMERAL_CLIENT_STATE",
      "temporal_egress": "NOT_APPLICABLE \u2014 NO_FINITE_LIFESPAN_STATES"
    },
    "4_idempotency_and_ordering": {
      "strategy": "GENERATION_SEQUENCING",
      "ordering_key": "request_seq",
      "justification": "Month selection is actor-repeatable and requires request sequence counters to discard stale out-of-order network responses."
    },
    "5_external_boundaries": {
      "boundary_fixtures": [
        "contract-fixtures/manifest.json"
      ],
      "resource_guards": [
        "abort_controller_guard",
        "http_timeout_guard"
      ],
      "concurrency_budget": {
        "worker_concurrency": 1,
        "probed_pool_capacity": 5,
        "reserved_headroom": 1
      }
    },
    "6_observation_and_actor_modality": {
      "primary_observer": "TimelogViewerUI",
      "verification_medium": "rendered_ui",
      "input_modalities": [
        "pointer",
        "keyboard"
      ],
      "environment_floor": "viewport_1024x768",
      "headless_fallback": "NOT_APPLICABLE \u2014 attended browser session only"
    }
  },
  "bootstrap_floor": [
    "package.json",
    "tsconfig.json",
    "src/server/index.ts",
    "src/client/index.html",
    "src/client/app.ts",
    "src/client/style.css"
  ],
  "pure_modules": [
    "src/core/aggregator.ts"
