# ==============================================================================
# Jira Worklog Configuration (Scope: timelog-generator Jira exports)
# ==============================================================================
JIRA_SERVER="https://your-domain.atlassian.net"
JIRA_USER="developer@example.com"
JIRA_API_TOKEN="your-jira-api-token"

# Scope: timelog-generator commit author extraction filter
TARGET_AUTHOR_EMAIL="developer@example.com"

# Scope: timelog-generator default Jira Epic mapping
JIRA_EPIC_KEY="PROJ-100"

# Scope: timelog-generator - comma-separated co-author names/emails to exclude from time logs
TIMELOG_EXCLUDE_CO_AUTHORS="bot-name,bot@example.com"
